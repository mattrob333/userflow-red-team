# Proposed UserFlow configuration. No real secrets. Existing local helpers do not
# consume these hosted settings. Load env explicitly in the future trusted worker.
ANTHROPIC_API_KEY=
USERFLOW_AGENT_RUNTIME=claude-agent-sdk
USERFLOW_COORDINATOR_MODEL=claude-opus-5-5
USERFLOW_SUBAGENT_MODEL=claude-opus-5-5
USERFLOW_MAX_ACTIVE_PERSONAS=3
USERFLOW_MAX_SPAWN_DEPTH=1
# Example defaults only; the user must approve actual job limits before spending.
USERFLOW_MAX_QUERY_TURNS=60
USERFLOW_MAX_QUERY_BUDGET_USD=10
USERFLOW_MAX_RUN_BUDGET_USD=25
USERFLOW_MAX_RUN_SECONDS=1800
# Future hosted service configuration. Empty until provider choices are made.
DATABASE_URL=
USERFLOW_OBJECT_BUCKET=
USERFLOW_QUEUE_URL=
USERFLOW_KMS_KEY_ID=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# Never use browser-exposed prefixes for secrets. Prefer managed credential refs
# over shared flat env variables in multi-tenant hosting. Do not pass this entire
# environment to an uploaded app or an agent shell.
